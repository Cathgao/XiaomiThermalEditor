<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#111827"
    android:fitsSystemWindows="true"
    android:orientation="vertical"
    android:padding="12dp">

    <!-- 顶部状态栏 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="小米温控编辑器"
                android:textColor="#F9FAFB"
                android:textSize="18sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tv_device_info"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Xiaomi 15 Pro (haotian)"
                android:textColor="#9CA3AF"
                android:textSize="12sp" />
        </LinearLayout>

        <TextView
            android:id="@+id/tv_root_status"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/badge_bg"
            android:paddingHorizontal="10dp"
            android:paddingVertical="4dp"
            android:text="Root 已授权"
            android:textColor="#34D399"
            android:textSize="11sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- 目标文件选择卡片 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:background="@drawable/card_bg"
        android:orientation="vertical"
        android:padding="10dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="8dp"
                android:text="配置文件:"
                android:textColor="#9CA3AF"
                android:textSize="12sp" />

            <Spinner
                android:id="@+id/sp_files"
                android:layout_width="0dp"
                android:layout_height="36dp"
                android:layout_weight="1"
                android:background="@drawable/input_bg"
                android:popupBackground="#1F2937" />

            <Button
                android:id="@+id/btn_reload"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:layout_marginStart="8dp"
                android:background="@drawable/btn_secondary"
                android:minWidth="0dp"
                android:paddingHorizontal="10dp"
                android:text="重载"
                android:textColor="#E5E7EB"
                android:textSize="12sp" />
        </LinearLayout>

        <!-- 加密状态徽章 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/tv_key_badge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/badge_bg"
                android:paddingHorizontal="8dp"
                android:paddingVertical="2dp"
                android:text="检测密钥: 经典 (thermalopenssl.h)"
                android:textColor="#10B981"
                android:textSize="11sp" />

            <TextView
                android:id="@+id/tv_file_path"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:layout_weight="1"
                android:ellipsize="middle"
                android:singleLine="true"
                android:text="/data/vendor/thermal/config"
                android:textColor="#6B7280"
                android:textSize="11sp" />
        </LinearLayout>
    </LinearLayout>

    <!-- 模式切换：可视化编辑 vs 源码文本 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="36dp"
        android:layout_marginTop="8dp"
        android:orientation="horizontal">

        <Button
            android:id="@+id/btn_tab_visual"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="@drawable/btn_primary"
            android:text="可视化编辑"
            android:textColor="#FFFFFF"
            android:textSize="13sp" />

        <Button
            android:id="@+id/btn_tab_raw"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_marginStart="8dp"
            android:layout_weight="1"
            android:background="@drawable/btn_secondary"
            android:text="源码查看/编辑"
            android:textColor="#D1D5DB"
            android:textSize="13sp" />
    </LinearLayout>

    <!-- 可视化编辑视图容器 -->
    <LinearLayout
        android:id="@+id/layout_visual_mode"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="8dp"
        android:layout_weight="1"
        android:orientation="vertical">

        <!-- 区域 (Section) 选择栏 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/card_bg"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:padding="8dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="6dp"
                android:text="区域:"
                android:textColor="#9CA3AF"
                android:textSize="12sp" />

            <Spinner
                android:id="@+id/sp_sections"
                android:layout_width="0dp"
                android:layout_height="34dp"
                android:layout_weight="1"
                android:background="@drawable/input_bg"
                android:popupBackground="#1F2937" />

            <TextView
                android:id="@+id/tv_section_badge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:background="@drawable/badge_bg"
                android:paddingHorizontal="8dp"
                android:paddingVertical="3dp"
                android:text="2 档位"
                android:textColor="#34D399"
                android:textSize="11sp" />
        </LinearLayout>

        <!-- 档位列表标题与新增档位按钮 -->
        <LinearLayout
            android:id="@+id/layout_tier_header"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingHorizontal="4dp">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="档位列表 (长按或按住手柄拖动顺序)"
                android:textColor="#9CA3AF"
                android:textSize="12sp" />

            <Button
                android:id="@+id/btn_add_tier"
                android:layout_width="wrap_content"
                android:layout_height="32dp"
                android:background="@drawable/btn_primary"
                android:minWidth="0dp"
                android:paddingHorizontal="12dp"
                android:text="+ 增加档位"
                android:textColor="#FFFFFF"
                android:textSize="12sp" />
        </LinearLayout>

        <!-- 档位 RecyclerView (支持手势拖动) -->
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rv_tiers"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_marginTop="4dp"
            android:layout_weight="1"
            android:clipToPadding="false"
            android:scrollbars="vertical" />

        <!-- 非档位参数 (如 algo_type, sensor 等) 可折叠/滑动区 -->
        <LinearLayout
            android:id="@+id/layout_section_params"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:background="@drawable/card_bg"
            android:orientation="vertical"
            android:padding="8dp">

            <TextView
                android:id="@+id/tv_params_header"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="基础参数 (algo_type / sensor / device / polling)"
                android:textColor="#9CA3AF"
                android:textSize="11sp" />

            <LinearLayout
                android:id="@+id/container_params"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:orientation="vertical" />
        </LinearLayout>

    </LinearLayout>

    <!-- 源码模式视图容器 (默认隐藏) -->
    <LinearLayout
        android:id="@+id/layout_raw_mode"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="8dp"
        android:layout_weight="1"
        android:orientation="vertical"
        android:visibility="gone">

        <EditText
            android:id="@+id/et_raw_content"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@drawable/card_bg"
            android:gravity="top|start"
            android:inputType="textMultiLine"
            android:padding="10dp"
            android:textColor="#E5E7EB"
            android:textSize="12sp"
            android:typeface="monospace" />
    </LinearLayout>

    <!-- 底部操作按钮栏 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:orientation="horizontal">

        <Button
            android:id="@+id/btn_restore_bak"
            android:layout_width="0dp"
            android:layout_height="44dp"
            android:layout_marginEnd="6dp"
            android:layout_weight="1"
            android:background="@drawable/btn_secondary"
            android:text="恢复备份"
            android:textColor="#D1D5DB"
            android:textSize="13sp" />

        <Button
            android:id="@+id/btn_restart_service"
            android:layout_width="0dp"
            android:layout_height="44dp"
            android:layout_marginEnd="6dp"
            android:layout_weight="1"
            android:background="@drawable/btn_secondary"
            android:text="重启温控"
            android:textColor="#34D399"
            android:textSize="13sp" />

        <Button
            android:id="@+id/btn_save"
            android:layout_width="0dp"
            android:layout_height="44dp"
            android:layout_weight="1.6"
            android:background="@drawable/btn_primary"
            android:text="保存并加密应用"
            android:textColor="#FFFFFF"
            android:textSize="14sp"
            android:textStyle="bold" />
    </LinearLayout>

</LinearLayout>

